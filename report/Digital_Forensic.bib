@article{selvarajInterframeForgeryDetection2020,
  title = {Inter-Frame Forgery Detection and Localisation in Videos Using Earth Mover's Distance Metric},
  author = {Selvaraj, Priyadharsini and Karuppiah, Muneeswaran},
  year = 2020,
  journal = {IET Image Processing},
  volume = {14},
  number = {16},
  pages = {4168--4177},
  issn = {1751-9667},
  doi = {10.1049/iet-ipr.2020.0287},
  urldate = {2025-12-02},
  abstract = {Video forensics is one of the hot topics in multimedia forensics. Nowadays, spreading fake videos across the internet is becoming a profession mainly in politics and entertainment. In this study, a novel two-stage inter-frame video forgery detection technique is proposed. The first stage analyses spatio-temporal feature flow consistency to detect suspicious tamper points. Identifying the type of forgery and validating the recovered video are done in the second stage. Earth mover's distance is used as a similarity metric in both stages. The authors concentrate on a robust inter-frame forgery detection approach which can be applied for any challenging video. Compression at a higher rate, noise addition, and filtering are the anti-forensic tricks used by forgers to fool forensic techniques. However, most of the literature in video forgery detection has handled these issues as post-processing attacks and reported lesser accuracies for it. Hence the authors propose a robust and efficient forgery detection technique capable of identifying all kinds of inter-frame forgeries in videos. Experimental evaluation of the public video data set shows that the proposed approach outperforms existing approaches with an improved rate of robustness.},
  copyright = {\copyright{} 2020 The Authors. IET Image Processing published by John Wiley \& Sons, Ltd. on behalf of The Institution of Engineering and Technology},
  langid = {english},
  keywords = {anti-forensic tricks,challenging video,copy protection,data compression,earth mover,efficient forgery detection technique,fake videos,feature extraction,forensic techniques,image forensics,image sequences,inter-frame forgeries,multimedia forensics,public video data set,recovered video,robust forgery detection technique,robust inter-frame forgery detection approach,stage analyses spatio-temporal feature flow consistency,two-stage inter-frame video forgery detection technique,video coding,video forensics,video signal processing},
  file = {C\:\\Users\\Sinbad\\Zotero\\storage\\GTFY4ZU2\\Selvaraj and Karuppiah - 2020 - Inter-frame forgery detection and localisation in videos using earth mover's distance metric.pdf;C\:\\Users\\Sinbad\\Zotero\\storage\\P6HDR943\\iet-ipr.2020.html}
