@article{xuDetectingDoubleH2662022,
  title = {Detecting Double {{H}}.266/{{VVC}} Compression with the Same Coding Parameters},
  author = {Xu, Qiang and Xu, Dongmei and Wang, Hao and Mi, Zhongjie and Wang, Zhe and Yan, Hong},
  year = 2022,
