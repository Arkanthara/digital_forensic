}

@article{uddinDoubleCompressionDetection2022,
  title = {Double Compression Detection in {{HEVC-coded}} Video with the Same Coding Parameters Using Picture Partitioning Information},
  author = {Uddin, Kutub and Yang, Yoonmo and Oh, Byung Tae},
