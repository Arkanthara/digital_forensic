% Minimal Quarto PDF style for title page & footer, vertical mode safe!

\usepackage[margin=1in,a4paper]{geometry}
\usepackage{graphicx}
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage{hyperref}

% Optional: university logo (adjust/remove if needed)
\newcommand{\unilogo}[1]{\includegraphics[width=#1\linewidth]{../images/unige.pdf}}

% Custom title page (horizontal mode for all variables)
\newcommand{\customtitlepage}{
    \begin{titlepage}
        \centering
        {\huge Université de Genève \\[0.2cm] Sciences Informatiques\par}
        \vspace{0.8cm}
        \unilogo{0.7}
        \vspace{1.2cm}

        {\LARGE \textbf{\@title}}
        \vspace{0.5cm}
        {\large \href{https://github.com/David-Kyrat/13X005-AI-Project}{Repository Github: 13X005-AI-Project}\par}
        \vspace{0.4cm}
        {\large \@author\par}
        \vfill
        {\@date\par}
    \end{titlepage}
    \clearpage
    \setcounter{page}{1}
}

% Ensure header/footer uses horizontal mode
\fancyhf{} % Clear all header/footer
\pagestyle{fancy}
\lhead{\begin{tabular}{@{}l@{}}Université de Genève\\Sciences Informatiques\end{tabular}}
\rhead{{\@title}}
\lfoot{\hspace{-1.8cm}\unilogo{0.08}}
\rfoot{Page \thepage\ / \pageref{LastPage}}
\cfoot{}

% Use custom title page for \maketitle
\renewcommand{\maketitle}{\customtitlepage}

% Hyperref colors
\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    urlcolor=blue,
}

% Remove paragraph indent
\setlength{\parindent}{0cm}
